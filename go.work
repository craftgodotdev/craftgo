// The workspace exists because the published nested modules - pkg/events and
// its nats/kafka adapters - carry no `replace` directives: a release pins
// `require github.com/craftgodotdev/craftgo/pkg/events vX.Y.Z`, and a consumer
// of pkg/events/nats@vX.Y.Z must get that real version, not a local path.
// Inside this repo the workspace does the resolving instead, so a change to
// pkg/events is visible to the adapters (and to the examples and the e2e
// fixture) before it is tagged or pushed.
//
// `go mod tidy` ignores workspaces, so example/ and tests/e2e/matrix keep
// their `replace` lines: those are what make `make tidy` resolve the
// placeholder `v0.0.0` requires without a network round-trip.
go 1.26.6

use (
	.
	./example/brokers
	./example/ecommerce
	./example/raw
	./example/taskflow
	./example/todo
	./example/upload
	./pkg/events
	./pkg/events/kafka
	./pkg/events/nats
	./tests/e2e/matrix
)
