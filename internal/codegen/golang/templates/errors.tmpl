{{- /*
errors.tmpl renders one error declaration: its code const, an optional body
struct, the error type with its methods and constructor.
*/ -}}
// {{.ConstName}} is the canonical machine-readable code for {{.TypeName}}.
const {{.ConstName}} = {{.QuotedCode}}

{{if .HasBody -}}
// {{.BodyName}} is the wire-shape payload declared at design time for {{.TypeName}}.
// User code instantiates this struct and hands it to {{.CtorName}}.
type {{.BodyName}} struct {
{{.BodyInterior}}}
{{end -}}

{{range .Doc}}// {{.}}
{{end}}// {{.TypeName}} is the typed {{.Category}} error generated for `{{.DSLName}}`.
type {{.TypeName}} struct{{if .HasBody}} {
	{{.BodyName}}
}{{else}}{}{{end}}

// {{.CtorName}} constructs {{.TypeName}}.
func {{.CtorName}}({{if .HasBody}}body {{.BodyName}}{{end}}) *{{.TypeName}} {
	return &{{.TypeName}}{ {{- if .HasBody}}{{.BodyName}}: body{{end -}} }
}

// Error returns the {{.Category}} category's default message.
func (e *{{.TypeName}}) Error() string { return {{.QuotedMessage}} }

// ErrCode returns {{.ConstName}}. It is named so that it does not shadow a
// `code` field of the body; rpc.Error puts it on the gRPC status.
func (e *{{.TypeName}}) ErrCode() string { return {{.ConstName}} }

// HTTPStatus returns the HTTP status code associated with the {{.Category}}
// category. server.WriteError answers with it, and rpc.Error maps it onto
// the matching gRPC status code.
func (e *{{.TypeName}}) HTTPStatus() int { return {{.Status}} }
{{if .HasJSONMember}}
// MarshalJSON encodes the body alone.
func (e *{{.TypeName}}) MarshalJSON() ([]byte, error) { return json.Marshal(e.{{.BodyName}}) }
{{else}}
// MarshalJSON encodes the {"code", "message"} envelope.
func (e *{{.TypeName}}) MarshalJSON() ([]byte, error) {
	return json.Marshal(map[string]string{"code": {{.ConstName}}, "message": e.Error()})
}
{{end -}}
{{if .HasResponseHeaders}}
// WriteResponseHeaders writes the `@header` / `@cookie` fields onto w.
// Called by the framework's server.WriteError before the JSON body is
// encoded so values reach the wire in a single response.
func (e *{{.TypeName}}) WriteResponseHeaders(w http.ResponseWriter) {
{{- range .Headers}}
	{{.Bind}}
{{- end}}
{{- range .Cookies}}
	{{.Bind}}
{{- end}}
}
{{end -}}
