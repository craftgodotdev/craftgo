var {{.Name}} = craftevents.NewEvent[{{.PayloadType}}]({{.ConstName}}, {{.Validate}})
{{if .ValidateElems}}
// {{.Validate}} validates every element the payload carries. The failing
// element names its index, and the descriptor turns the error into a
// *craftevents.PayloadError exactly as it does for a single payload.
func {{.Validate}}(items *{{.PayloadType}}) error {
	for i := range *items {
		if err := (*items)[i].Validate(); err != nil {
			return fmt.Errorf("item %d: %w", i, err)
		}
	}
	return nil
}
