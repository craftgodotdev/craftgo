package {{.Package}}

import (
{{- if .Sig.IsUnary}}
	"context"
{{end}}
	"github.com/craftgodotdev/craftgo/pkg/rpc"
{{- if not .Sig.IsUnary}}
	"google.golang.org/grpc"
{{- end}}

	service "{{.ServiceImport}}"
{{- range .Imports}}
	{{.Alias}} "{{.Path}}"
{{- end}}
)

{{- range .Doc}}
// {{.}}
{{- end}}
// {{.Method}} serves the {{.Sig.Kind}} RPC {{.FullMethod}}: it hands the
// call context to the logic and maps the error it returns onto a status,
// as the HTTP handler does with WriteError.
func (s *Server) {{.Method}}({{.Sig.ServerParams}}) {{.Sig.Logic.Results}} {
{{- if not .Sig.IsUnary}}
	ctx := stream.Context()
{{- end}}
{{- if .Sig.HasRequest}}
	if err := rpc.Validate(req); err != nil {
		return {{if .Sig.HasResponse}}nil, {{end}}err
	}
{{- end}}
	l := service.New{{.ServiceName}}(ctx, s.svcCtx)
{{- if .Sig.HasResponse}}
	resp, err := l.{{.Method}}({{.Sig.Logic.CallArgs}})
	if err != nil {
		return nil, rpc.Error(ctx, err)
	}
	return resp, nil
{{- else}}
	if err := l.{{.Method}}({{.Sig.Logic.CallArgs}}); err != nil {
		return rpc.Error(ctx, err)
	}
	return nil
{{- end}}
}
