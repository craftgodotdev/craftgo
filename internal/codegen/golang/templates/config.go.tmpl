
// Package config loads the runtime settings from {{.ConfigDir}}/config.yaml.
package config

import (
	"bytes"
	"errors"
	"fmt"
	"os"
	"time"

	"github.com/craftgodotdev/craftgo/pkg/log"
	"github.com/craftgodotdev/craftgo/pkg/telemetry"
	"gopkg.in/yaml.v3"
)

// Config is the shape of `{{.ConfigDir}}/config.yaml`; the inlined telemetry.Config puts
// serviceName, otel and metrics at its top level.
type Config struct {
{{- if .HasHTTP}}
	Server            ServerConfig `yaml:"server"`
{{- end}}
{{- if .HasGRPC}}
	GRPC              GRPCConfig   `yaml:"grpc"`
{{- end}}
	Logging           LogConfig    `yaml:"logging"`
	telemetry.Config  `yaml:",inline"`
{{- if .HasHTTP}}
	Docs              DocsConfig `yaml:"docs"`
{{- end}}
}

// LogConfig configures the process-wide logger.
type LogConfig struct {
	// Level is "debug", "info" (the default), "warn" or "error"; main.go passes it to
	// log.SetLevel.
	Level string `yaml:"level"`
}

{{- if .HasHTTP}}

// DocsConfig configures the API-reference page main.go serves beside the OpenAPI document.
type DocsConfig struct {
	// Enabled serves the docs and spec routes; false, the zero value, serves neither.
	Enabled bool `yaml:"enabled"`

	// UI is the renderer: "redoc" (the default), "swagger" or "scalar".
	UI string `yaml:"ui"`

	// Path is the docs page route, "/docs" by default.
	Path string `yaml:"path"`

	// SpecPath is the OpenAPI document route, "/openapi.yaml" by default.
	SpecPath string `yaml:"specPath"`
}
{{- end}}
{{- if .HasHTTP}}

// ServerConfig configures the HTTP listener and the defaults its routes take. Its write deadline
// and header cap are the server's SetDefault* setters, for main.go to call when needed.
type ServerConfig struct {
	// Addr is the HTTP bind address, e.g. ":8080" or "127.0.0.1:8080".
	Addr string `yaml:"addr"`

	// ReadTimeout bounds reading a whole request, its body included; 30s unless config.yaml
	// sets one, 0 setting none.
	ReadTimeout time.Duration `yaml:"readTimeout"`

	// HandlerTimeout is the request-context deadline of a route without @timeout; 0 sets none.
	HandlerTimeout time.Duration `yaml:"handlerTimeout"`

	// MaxBodySize is the body cap in bytes of a route without @maxBodySize; 10 MiB unless
	// config.yaml sets one, 0 setting none.
	MaxBodySize int64 `yaml:"maxBodySize"`

	// StrictJSON rejects a JSON body with an unknown field or data after the value.
	StrictJSON bool `yaml:"strictJSON"`

	// Compression is off by default, for a deployment behind a compressing proxy.
	Compression CompressionConfig `yaml:"compression"`
}

// CompressionConfig configures gzip and deflate response compression.
type CompressionConfig struct {
	// Enabled wraps every route in server.Compress.
	Enabled bool `yaml:"enabled"`
	// MinSize is the smallest body compressed, in bytes; 0 means 1024.
	MinSize int `yaml:"minSize"`
	// Level is the compression level, 1 to 9; 0 means the default. main.go stops on one outside
	// -2 to 9.
	Level int `yaml:"level"`
}
{{- end}}

{{- if .HasGRPC}}

// GRPCConfig configures the gRPC listener.
type GRPCConfig struct {
	// Addr is the gRPC bind address, e.g. ":9000".
	Addr string `yaml:"addr"`

	// HandlerTimeout bounds unary calls, a shorter client deadline winning; streams are not
	// bounded. 0 sets none.
	HandlerTimeout time.Duration `yaml:"handlerTimeout"`

	// Reflection serves gRPC reflection for grpcurl and grpcui; keep it off on a public listener.
	Reflection bool `yaml:"reflection"`
}
{{- end}}

// The telemetry sections under local names; [telemetry.Config] documents their fields.
type (
	TelemetryConfig = telemetry.Config
	OTelConfig      = telemetry.OTelConfig
	MetricsConfig   = telemetry.MetricsConfig
)

// Path returns the location of config.yaml, relative to the project root.
func Path() string {
	return "{{.ConfigDir}}/config.yaml"
}

// Load reads cfgPath, unless it is empty, over [defaults], then fills the defaults the runtime
// lacks. A missing file keeps the defaults, and a key Config has no field for is skipped; each
// is logged as a warning.
func Load(cfgPath string) (*Config, error) {
	cfg := defaults()
	if cfgPath != "" {
		data, err := os.ReadFile(cfgPath)
		switch {
		case os.IsNotExist(err):
			log.Default().Warn("config file not found, using the defaults", log.String("path", cfgPath))
		case err != nil:
			return nil, fmt.Errorf("read %s: %w", cfgPath, err)
		default:
			if err := yaml.Unmarshal(data, cfg); err != nil {
				return nil, fmt.Errorf("parse %s: %w", cfgPath, err)
			}
			for _, detail := range unknownKeys(data) {
				log.Default().Warn("unknown config key ignored", log.String("path", cfgPath), log.String("detail", detail))
			}
		}
	}
	cfg.applyDefaults()
	return cfg, nil
}

// unknownKeys returns yaml's "line N: field K not found in type T" for each key in data that
// Config has no field for.
func unknownKeys(data []byte) []string {
	dec := yaml.NewDecoder(bytes.NewReader(data))
	dec.KnownFields(true)
	var te *yaml.TypeError
	if errors.As(dec.Decode(defaults()), &te) {
		return te.Errors
	}
	return nil
}

// defaults returns the settings whose zero value is a choice of its own, which a key config.yaml
// leaves out keeps.
func defaults() *Config {
{{- if .HasHTTP}}
	return &Config{
		Server: ServerConfig{
			ReadTimeout: 30 * time.Second,
			MaxBodySize: 10 << 20,
		},
	}
{{- else}}
	return &Config{}
{{- end}}
}

// applyDefaults fills the fields the runtime has no default of its own for.
func (c *Config) applyDefaults() {
{{- if .HasHTTP}}
	if c.Server.Addr == "" {
		c.Server.Addr = ":8080"
	}
{{- end}}
{{- if .HasGRPC}}
	if c.GRPC.Addr == "" {
		c.GRPC.Addr = ":9000"
	}
{{- end}}
	if c.ServiceName == "" {
		c.ServiceName = "{{.OperationName}}"
	}
}
