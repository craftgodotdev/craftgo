
// main serves the design's {{if and .HasRoutes .HasGRPC}}HTTP routes and gRPC services{{else if .HasGRPC}}gRPC services{{else}}HTTP routes{{end}} with the settings in {{.ConfigDir}}/config.yaml,
// whose keys {{.ConfigDir}}/example.config.yaml documents.
package main

import (
	"context"
{{- if .HasDocs}}
	_ "embed"
{{- end}}
	"net"
	"os"
	"os/signal"
{{- if and .HasRoutes .HasGRPC}}
	"sync"
{{- end}}
	"syscall"
	"time"

	"github.com/craftgodotdev/craftgo/pkg/log"
{{- if .HasGRPC}}
	"github.com/craftgodotdev/craftgo/pkg/rpc"
{{- end}}
{{- if .HasRoutes}}
	"github.com/craftgodotdev/craftgo/pkg/server"
{{- end}}
	"github.com/craftgodotdev/craftgo/pkg/telemetry"

	"{{.ConfigImport}}"
	"{{.WiringImport}}"
{{- if .Middlewares}}
	"{{.MiddlewareImport}}"
{{- end}}
	"{{.SvccontextImport}}"
)
{{- if .HasDocs}}

// openapiSpec is the generated OpenAPI document the docs page serves.
//
//go:embed {{.OpenAPIEmbed}}
var openapiSpec []byte
{{- end}}

func main() {
	cfg, err := config.Load(config.Path())
	if err != nil {
		log.Default().Error("load config", log.Err(err))
		os.Exit(1)
	}

	// An unrecognised logging.level keeps the info default.
	if lvl, ok := log.ParseLevel(cfg.Logging.Level); ok {
		log.SetLevel(lvl)
	}

	ctx := context.Background()
	tel, err := telemetry.Init(ctx, cfg.Config)
	if err != nil {
		log.Default().Error("init telemetry", log.Err(err))
		os.Exit(1)
	}
	if url := tel.ScrapeURL(); url != "" {
		log.Default().Info("metrics scrape listening", log.String("url", url))
	}
	if errCh := tel.AdminErr(); errCh != nil {
		go func() {
			if err := <-errCh; err != nil {
				log.Default().Error("metrics scrape listener", log.Err(err))
			}
		}()
	}

	svc := svccontext.NewServiceContext(cfg)
{{- if .Middlewares}}

	// Each middleware the design declares is a field of svc, assigned once here.
{{- range .Middlewares}}
	svc.{{.}} = middleware.New{{.}}Middleware()
{{- end}}
{{- end}}
{{- if .HasRoutes}}

	// The telemetry wrapper opens each request's span outside Recovery and every Use
	// middleware, so the access and panic lines carry its trace ids.
	srv := server.New(svc, server.WithTelemetry(tel.HTTPMiddleware()))
	srv.Use(server.AccessLog(log.Follow()))
	// A method's @timeout or @maxBodySize overrides these defaults; routes resolve them
	// when wiring.Register registers them.
	srv.SetDefaultReadTimeout(cfg.Server.ReadTimeout)
	srv.SetDefaultHandlerTimeout(cfg.Server.HandlerTimeout)
	srv.SetDefaultMaxBodySize(cfg.Server.MaxBodySize)
	if err := server.SetStrictJSON(cfg.Server.StrictJSON); err != nil {
		log.Default().Error("strict json", log.Err(err))
		os.Exit(1)
	}
	if cfg.Server.Compression.Enabled {
		compress := server.CompressOptions{
			MinSize: cfg.Server.Compression.MinSize,
			Level:   cfg.Server.Compression.Level,
		}
		if err := compress.Validate(); err != nil {
			log.Default().Error("server.compression", log.Err(err))
			os.Exit(1)
		}
		srv.Use(server.Compress(compress))
	}

	// wiring is regenerated on each craftgo gen and registers every HTTP route the design
	// declares.
	shutdownWiring, err := wiring.Register(ctx, srv, svc)
	if err != nil {
		log.Default().Error("wire services", log.Err(err))
		os.Exit(1)
	}
{{- if .HasDocs}}

	// The docs page loads its UI assets from a CDN. Its routes come after the design's, so a
	// docs path one of them has stops the boot.
	if cfg.Docs.Enabled {
		if err := srv.RegisterDocs(server.DocsOptions{
			Spec:     openapiSpec,
			UI:       cfg.Docs.UI,
			Path:     cfg.Docs.Path,
			SpecPath: cfg.Docs.SpecPath,
		}); err != nil {
			log.Default().Error("docs", log.Err(err))
			os.Exit(1)
		}
	}
{{- end}}
{{- end}}
{{- if .HasGRPC}}

	// The stats handler opens each call's span ahead of Recovery and every interceptor, so the
	// access and panic lines carry its trace ids.
	grpcSrv := rpc.New(svc,
		rpc.WithStatsHandler(tel.GRPCServerHandler()),
		rpc.WithReflection(cfg.GRPC.Reflection),
	)
	grpcSrv.Use(rpc.AccessLog(log.Follow()))
	// The unary deadline; a shorter client deadline wins, and streams are not bounded.
	grpcSrv.Use(rpc.Timeout(cfg.GRPC.HandlerTimeout))

	// wiring is regenerated on each craftgo gen and registers every gRPC service the protos
	// declare.
	shutdownGRPC, err := wiring.RegisterGRPC(ctx, grpcSrv, svc)
	if err != nil {
		log.Default().Error("wire grpc services", log.Err(err))
		os.Exit(1)
	}
{{- end}}

	stop := make(chan os.Signal, 1)
	signal.Notify(stop, syscall.SIGINT, syscall.SIGTERM)
	// Each listener logs the address it bound, with the real port of a ":0". One that cannot bind,
	// or stops serving, shuts the rest down as a signal does, and the process then exits 1.
	failed := make(chan struct{}, {{if and .HasRoutes .HasGRPC}}2{{else}}1{{end}})
{{- if .HasRoutes}}

	go func() {
		lis, err := net.Listen("tcp", cfg.Server.Addr)
		if err == nil {
			log.Default().Info("listening", log.String("addr", lis.Addr().String()))
			err = srv.Serve(lis)
		}
		if err != nil {
			log.Default().Error("server start", log.Err(err))
			failed <- struct{}{}
		}
	}()
{{- end}}
{{- if .HasGRPC}}

	go func() {
		lis, err := net.Listen("tcp", cfg.GRPC.Addr)
		if err == nil {
			log.Default().Info("grpc listening", log.String("addr", lis.Addr().String()))
			err = grpcSrv.Serve(lis)
		}
		if err != nil {
			log.Default().Error("grpc server start", log.Err(err))
			failed <- struct{}{}
		}
	}()
{{- end}}

	exitCode := 0
	select {
	case <-stop:
	case <-failed:
		exitCode = 1
	}
{{- if and .HasRoutes .HasGRPC}}

	// Both listeners stop at once, the gRPC health service turning NOT_SERVING as HTTP stops
	// accepting, and drain side by side within one budget, each followed by its wiring shutdown.
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	var wg sync.WaitGroup
	wg.Go(func() {
{{- template "stopHTTP"}}
	})
	wg.Go(func() {
{{- template "stopGRPC"}}
	})
	wg.Wait()
{{- else if .HasRoutes}}

	// The listener stops accepting and drains within the budget, then the wiring shuts down.
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
{{- template "stopHTTP"}}
{{- else}}

	// The health service turns NOT_SERVING as the listener stops taking calls; it drains within
	// the budget, then the wiring shuts down.
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
{{- template "stopGRPC"}}
{{- end}}
	// Shutdown closes the scrape listener and flushes any pending OTLP batch.
	if err := tel.Shutdown(shutdownCtx); err != nil {
		log.Default().Error("shutdown telemetry", log.Err(err))
	}
	cancel()
	if exitCode != 0 {
		os.Exit(exitCode)
	}
}
{{- define "stopHTTP"}}
	if err := srv.Stop(shutdownCtx); err != nil {
		log.Default().Warn("http drain cut off requests", log.Err(err))
	}
	if err := shutdownWiring(shutdownCtx); err != nil {
		log.Default().Error("shutdown wiring", log.Err(err))
	}
{{- end}}
{{- define "stopGRPC"}}
	if err := grpcSrv.Stop(shutdownCtx); err != nil {
		log.Default().Warn("grpc drain cut off calls", log.Err(err))
	}
	if err := shutdownGRPC(shutdownCtx); err != nil {
		log.Default().Error("shutdown grpc wiring", log.Err(err))
	}
{{- end}}
