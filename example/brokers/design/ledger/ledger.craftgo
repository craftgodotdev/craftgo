// ledger is a third group on orders.Placed, and the only consumer of the
// upstream payment contract - so it is where the two meet.
package ledger

service LedgerService {
	@doc("Books the order against the account.")
	consume BookOrder {
		event orders.Placed
	}

	@doc("Reconciles a payment the platform published.")
	consume RecordSettlement {
		event payments.Settled
	}
}
