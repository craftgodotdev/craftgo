// notifications reacts to an order by talking to the customer. It is the
// only consumer that follows an order through both of its events.
package notifications

service NotificationService {
	@doc("Emails the customer once the order is accepted.")
	consume SendReceipt {
		event orders.Placed
	}

	@doc("Tells the customer the order is on its way.")
	consume SendDispatchNote {
		event orders.Shipped
	}
}
