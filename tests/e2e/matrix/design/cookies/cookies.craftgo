// Package `cookies` pins the attributes of the cookies @cookie fields set, on a
// response and on an error: the server's cookie options, path / and HttpOnly,
// Secure and SameSite=Lax unless config sets others.
package cookies

// Session sets its token in a cookie beside its body.
type Session {
	token string @cookie("sid")
	name  string
}

// Locked sets the time it lifts in a cookie.
error Conflict Locked {
	until string @cookie("lock")
}

@prefix("/cookies/a")
service Cookies {
	@doc("Answers a Session.")
	get Login /login {
		response Session
	}

	@doc("Answers the Locked error.")
	@errors(Locked)
	get Lock /lock {
		response Session
	}
}
