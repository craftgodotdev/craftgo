package nested

// NestedService carries nested and mixin shapes in its requests and
// responses, so the generated validators, transports and OpenAPI cover them.
@prefix("/nested")
@tags(nested)
service NestedService {
	@doc("Plain nested - User has an Address. Validates recursively.")
	post EchoUser /user {
		request  User
		response User
	}

	@doc("Deep chain - Person → Home → Room → Furniture exercises the four-level cascade.")
	post EchoPerson /person {
		request  Person
		response Person
	}

	@doc("Slice of nested with array-level bounds.")
	post EchoTeam /team {
		request  Team
		response Team
	}

	@doc("Optional slice of nested.")
	post EchoOrg /org {
		request  Org
		response Org
	}

	@doc("Map of nested - validates map presence but does NOT recurse into values (map-value validators are not yet wired through the codegen walker).")
	post EchoCatalog /catalog {
		request  Catalog
		response Catalog
	}

	@doc("2-D slice of nested.")
	post EchoMatrix /matrix {
		request  Matrix
		response Matrix
	}

	@doc("3-D slice of nested.")
	post EchoCube /cube {
		request  Cube
		response Cube
	}

	@doc("Recursive tree node.")
	post EchoNode /node {
		request  Node
		response Node
	}

	@doc("Mutual recursion entry - request A traverses A → B → A → ...")
	post EchoA /a {
		request  A
		response A
	}

	@doc("Mutual recursion entry - request B traverses B → A → B → ...")
	post EchoB /b {
		request  B
		response B
	}

	@doc("Generic-instantiation-like page envelope.")
	post EchoListPage /list-page {
		request  ListPage
		response ListPage
	}

	post EchoAuditedHost /audited-host {
		request  AuditedHost
		response AuditedHost
	}

	post EchoHeaderedResp /headered-resp {
		request  ResponseAudit
		response HeaderedResp
	}

	get GetRateResp /rate-resp {
		response RateResp
	}
}
