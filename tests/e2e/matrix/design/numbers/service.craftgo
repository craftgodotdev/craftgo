// Service surface for the numbers package: one POST per case, so the
// transport and OpenAPI codegen exercise every numeric shape end to end.
package numbers

// CounterReq wraps NumberCounter for the AddCounter POST.
type CounterReq {
	body NumberCounter
}

// UnsignedReq wraps NumberUnsigned.
type UnsignedReq {
	body NumberUnsigned
}

// PriceReq wraps NumberPrice (float surface).
type PriceReq {
	body NumberPrice
}

// OptionalReq wraps NumberOptional (presence axes).
type OptionalReq {
	body NumberOptional
}

// MixedReq wraps NumberMixed (mixed strict/inclusive).
type MixedReq {
	body NumberMixed
}

// ExactReq wraps NumberExact (exact-match shapes).
type ExactReq {
	body NumberExact
}

// BoundaryReq wraps NumberBoundary (type-capacity edges).
type BoundaryReq {
	body NumberBoundary
}

// NumbersService exposes one POST per showcase type. Request and response
// share one type, so the codegen exercises both decode and encode paths
// against every numeric validator chain.
@prefix("/numbers")
service NumbersService {
	post AddCounter /counter {
		request  CounterReq
		response CounterReq
	}

	post AddUnsigned /unsigned {
		request  UnsignedReq
		response UnsignedReq
	}

	post AddPrice /price {
		request  PriceReq
		response PriceReq
	}

	post AddOptional /optional {
		request  OptionalReq
		response OptionalReq
	}

	post AddMixed /mixed {
		request  MixedReq
		response MixedReq
	}

	post AddExact /exact {
		request  ExactReq
		response ExactReq
	}

	post AddBoundary /boundary {
		request  BoundaryReq
		response BoundaryReq
	}

	post EchoBigBounds /big-bounds {
		request  NumberBigBounds
		response NumberBigBounds
	}

	post EchoMultipleOf /multiple-of {
		request  NumberMultipleOf
		response NumberMultipleOf
	}

	post EchoBigMultipleOf /big-multiple-of {
		request  NumberBigMultipleOf
		response NumberBigMultipleOf
	}
}
