package combine

// CombineService wires the cross-decorator combination types into real
// handlers: each method gives the codegen and transport stack a body to
// decode and validate.
@prefix("/combine")
@tags(combine)
service CombineService {
	@doc("Echo the presence-state matrix. Smoke tests assert that plain is in required[], optional / nullable / bothNullable produce a 'type: [string, null]' (OpenAPI 3.1 null), and the default rows surface a default key in OpenAPI.")
	post EchoPresence /presence {
		request  PresenceMatrix
		response PresenceMatrix
	}

	@doc("Validate stacked string decorators (length + format + pattern). The handler fails any of the three independently.")
	post ValidateStr /pairs/str {
		request  PairsStr
		response PairsStr
	}

	@doc("Validate stacked numeric decorators (range + multipleOf + gt + lte). All four fire in declaration order.")
	post ValidateNum /pairs/num {
		request  PairsNum
		response PairsNum
	}

	@doc("Validate stacked array decorators (minItems + maxItems + uniqueItems + each(@length)). Outer bounds plus per-element check.")
	post ValidateArr /pairs/arr {
		request  PairsArr
		response PairsArr
	}

	@doc("Validate per-field decorators under a type-level @requiresOneOf. Sending neither field fails the cross-field check; sending one passes.")
	post ValidateContact /pairs/contact {
		request  PairsContact
		response PairsContact
	}

	@doc("Validate orthogonal @mutuallyExclusive + @requiresOneOf. Sending only c is valid; sending a+b fails exclusivity; sending nothing fails the one-of.")
	post ValidateChoice /pairs/choice {
		request  PairsChoice
		response PairsChoice
	}

	@doc("Echo the boundary-default matrix. Smoke tests assert that the pre-fill happens before req.Validate() so the defaulted values land in the response.")
	post EchoBoundary /defaults/boundary {
		request  DefaultsBoundary
		response DefaultsBoundary
	}

	@doc("Echo the array / map default shapes. The map<,>?-with-object-default field is expected to be rejected at codegen time.")
	post EchoCollection /defaults/collection {
		request  DefaultsCollection
		response DefaultsCollection
	}

	@doc("Echo the enum default. Missing c on the wire results in c=Red after pre-fill.")
	post EchoEnum /defaults/enum {
		request  DefaultsEnum
		response DefaultsEnum
	}

	@doc("Echo the scalar default. Missing size on the wire results in size=20 after pre-fill, and the scalar's @gte/@lte bounds still apply.")
	post EchoScalar /defaults/scalar {
		request  DefaultsScalar
		response DefaultsScalar
	}

	@doc("Echo the narrow-width default matrix. The pre-fill casts each literal to the field primitive so the *T pointer assignment compiles (int32 / int64 / uint16 / float32).")
	post EchoWidth /defaults/width {
		request  DefaultsWidth
		response DefaultsWidth
	}

	@doc("Validate a path id beside a body keyed by @json names. The operation body and the @requiresOneOf name primary_email and backup_email; the response sends ETag as a header and primary_email in the body.")
	post ValidateRenamed /pairs/renamed/{id} {
		request  PairsRenamed
		response PairsRenamedResp
	}

	@doc("Validate a path id beside a body whose @requiresOneOf a nested mixin declares. The operation body carries the group: sending neither a nor b fails.")
	post ValidateNested /pairs/nested/{id} {
		request  PairsNested
		response PairsDoc
	}

	@doc("Upload a file beside the parts of a mixin with a @requiresOneOf. The multipart body carries the group: sending neither a nor b fails.")
	post UploadPairs /pairs/upload {
		request  PairsUpload
		response PairsDoc
	}

	@doc("Upload a file or a link, exactly one. The multipart body carries the request type's own groups; an empty url part counts as absent.")
	post UploadSource /pairs/source {
		request  PairsSource
		response PairsDoc
	}

	@doc("Tag a pair. The response sends ETag as a header; its body carries the response type's @mutuallyExclusive and its mixin's @requiresOneOf.")
	post TagPairs /pairs/tagged {
		request  PairsDoc
		response PairsTagged
	}

	post EchoZeroMember /enums/zero-member {
		request  ZeroMember
		response ZeroMember
	}

	post EchoWireDefaults /defaults/wire {
		request  WireDefaults
		response WireDefaults
	}

	post ValidatePromoted /pairs/promoted {
		request  PromotedContact
		response PromotedContact
	}

	post EchoCollidingNames /colliding-names {
		request  CollidingNames
		response CollidingNames
	}

	post EchoArrayDefaults /defaults/array {
		request  ArrayDefaults
		response ArrayDefaults
	}

	post EchoNilableNullable /nilable-nullable {
		request  NilableNullable
		response NilableNullable
	}

	post ValidateStacked /pairs/stacked {
		request  PairsStacked
		response PairsStacked
	}

	@errors(FieldRulesFailed)
	post ValidateChannels /pairs/channels {
		request  ContactChannels
		response ContactChannels
	}
}
