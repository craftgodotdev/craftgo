// consumemw.craftgo is the consume-middleware half of the event fixture:
// two declarations, a service-level chain, a consumer-level append, and
// one consumer that opts out of the inherited chain entirely. The
// generated chain order is what consume_middleware_test.go asserts, by
// counting attempts rather than reading frames - a reversed chain still
// enters in the order it was written.
package eventsubs

// Settle parks a failure and reports success, the way a dead-letter
// middleware does. Everything that wants to SEE a failure has to sit
// under it.
consume middleware Settle

// Attempt counts deliveries and asks for another while its budget
// holds, the way a retry middleware does.
consume middleware Attempt

// The chain is stated once for the service and appended to per consumer,
// so each consumer of the same contract can carry a different guarantee.
@consumeMiddlewares(Settle)
service GuardedService {
	@doc("Runs Settle then Attempt: the retry is nearest the handler, so a failed delivery is asked back before Settle parks it.")
	@consumeMiddlewares(Attempt)
	consume GuardedStock {
		event events.ItemStocked
	}

	@doc("Clears the inherited chain: this one runs nothing.")
	@ignoreMiddleware
	consume BareStock {
		event events.StocktakeStarted
	}
}

// An extend block's decorators reach the members whose level they fit,
// so this block's @doc and @deprecated land on its CONSUMER the way they
// already land on a block's methods. Nothing else in the fixture set
// exercises that path, and it is generated output - the doc comment on
// the handler and the deprecation in the AsyncAPI document - rather than
// behaviour, so the golden files are what pin it.
@doc("Inherited from the extend block.")
@deprecated
extend service GuardedService {
	consume InheritedStock {
		event events.WarehouseClosed
	}
}
