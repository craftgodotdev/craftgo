// eventsubs.craftgo holds the consumer side of the event fixture in a
// SEPARATE package, so the generated consumer has to import the
// publisher package's payload types rather than its own. It also splits
// consumers across a primary block and an `extend service` block, and
// puts one behind a `@group` so the grouped output path is exercised for
// events as well as methods.
package eventsubs

service NotificationService {
	@doc("Cross-package consumer: the payload type lives in `events`.")
	consume SendStockAlert {
		event events.ItemStocked
	}

	@doc("Consumes the @contract-renamed event by its DSL name.")
	consume AuditReconciliation {
		event events.Reconciled
	}
}

// A consumer declared in an extend block belongs to the OWNING service,
// so it derives `eventsubs-NotificationService-NotifyDispatch` - the
// extend block contributes nothing to the name.
extend service NotificationService {
	@doc("Declared in an extend block; merges into the same service.")
	consume NotifyDispatch {
		event events.ShipmentDispatched
	}
}

// A @group on an extend block splits ONE service's consumers across two
// logic folders while the contract still declares a single handler
// interface covering both, so the handler set that satisfies it lives at
// the root of the transport output rather than in either folder.
@group("stocktake")
extend service NotificationService {
	@doc("Grouped away from its siblings; still part of NotificationService's handler set.")
	consume TrackStocktake {
		event events.StocktakeStarted
	}
}

// @group decides where generated files land and must never reach the
// broker identity: this consumer derives
// `eventsubs-OpsService-RecordClosure`, with no trace of "ops" in it.
@group("ops")
service OpsService {
	@doc("A grouped service nests its generated event files under the group.")
	consume RecordClosure {
		event events.WarehouseClosed
	}
}

// AnalyticsService pins the consumer-group identity. The service-level
// decorator is the default for every consumer in the body, so two
// consumers of DIFFERENT contracts join one group - the group, not the
// consumer, is the unit of scaling and of failure isolation. One of them
// takes its own group to pin the consumer-level override.
@doc("A second group on a contract another service already consumes: every group receives every message, so one event drives two different tasks.")
@consumerGroup("analytics-worker")
service AnalyticsService {
	consume CountStocked {
		event events.ItemStocked
	}

	@doc("A different contract under the same group: the feature.")
	consume CountDispatched {
		event events.ShipmentDispatched
	}

	@doc("The consumer's own group wins over the service's.")
	@consumerGroup("analytics-tier-worker")
	consume TrackTier {
		event events.TierPromoted
	}
}
