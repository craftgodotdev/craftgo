// eventsubs.craftgo holds the consumer side of the event fixture in a
// SEPARATE package, so the generated handler interface has to import the
// declaring package's payload types rather than its own. It also splits
// one service's consumers across a primary block and two `extend service`
// blocks, all of which merge into a single handler interface.
package eventsubs

service NotificationService {
	@doc("Cross-package consumer: the payload type lives in `events`.")
	consume SendStockAlert {
		event events.ItemStocked
	}

	@doc("Consumes the @contract-renamed event by its DSL name.")
	consume AuditReconciliation {
		event events.Reconciled
	}
}

// A consumer declared in an extend block belongs to the OWNING service,
// so it becomes another method on NotificationServiceHandler - the extend
// block contributes nothing of its own.
extend service NotificationService {
	@doc("Declared in an extend block; merges into the same service.")
	consume NotifyDispatch {
		event events.ShipmentDispatched
	}
}

extend service NotificationService {
	@doc("A second extend block, merged into the same handler interface.")
	consume TrackStocktake {
		event events.StocktakeStarted
	}
}

// A second service in the same package: two handler interfaces land in
// one handlers.go, and each deployable registers only the ones it runs.
service OpsService {
	@doc("The only consumer of events.WarehouseClosed.")
	consume RecordClosure {
		event events.WarehouseClosed
	}
}

// AnalyticsService consumes two contracts another service already
// consumes. Which broker identity each joins is the deployable's to
// choose - the design says only that the handler exists.
@doc("A second consumer of a contract another service already consumes: every group receives every message, so one event drives two different tasks.")
service AnalyticsService {
	consume CountStocked {
		event events.ItemStocked
	}

	@doc("A different contract in the same handler interface.")
	consume CountDispatched {
		event events.ShipmentDispatched
	}

	consume TrackTier {
		event events.TierPromoted
	}
}
