package adminapi

// VerResp is a tiny versioned payload so each grouped block has its own
// server-roundtrip method.
type VerResp {
	version string
	ok      bool
}

// AdminApi splits its methods across nested @group folders of one package:
// admin/v1 (primary), admin/uptime, admin/v2 and admin/v3 (extend blocks).
// @group sets only the on-disk layout - handlers land in transport/admin/vN,
// stubs in service/admin/vN, routes in routes/admin/vN - never the URL, which
// comes from @prefix and the method path. RegisterRoutes of each segment
// registers that segment's methods.
@prefix("/adminapi")
@group("admin/v1")
service AdminApi {
	get PingV1 /v1/ping {
		response VerResp
	}
}

// The group segment ends in `time`, so the transport import alias reads
// `transportUptime` and the handler call spells `transportUptime.PingUptime`.
// No method in this segment carries @timeout, so its routes.go must import
// no `time` - a decision made by searching the handler call for `time.`
// keeps the import and the file fails with "imported and not used".
@group("admin/uptime")
extend service AdminApi {
	get PingUptime /uptime/ping {
		response VerResp
	}
}

@group("admin/v2")
extend service AdminApi {
	get PingV2 /v2/ping {
		response VerResp
	}
}

@group("admin/v3")
extend service AdminApi {
	get PingV3 /v3/ping {
		response VerResp
	}
}

// This extend block declares NO @group, so it inherits the primary's
// @group("admin/v1"): PingInherit lands in transport/admin/v1 + service/admin/v1
// and registers through the routes/admin/v1 hub, not the ungrouped service root.
extend service AdminApi {
	get PingInherit /inherit/ping {
		response VerResp
	}
}
