// Package `hidden` pins what @hidden leaves out of the document: a hidden
// method, extend block and service are still served, and each schema and
// security scheme only hidden methods use leaves with them.
package hidden

// Note is answered by a documented method and by hidden ones.
type Note {
	text string
}

// Secret is taken and answered only by hidden methods.
type Secret {
	key string
}

// Stash is taken only by a hidden method, with the enum it binds.
type Stash {
	tier Tier @query
}

enum Tier {
	Low
	High
}

// Vault is answered, over Secret, only by a hidden method.
type Vault<T> {
	items T[]
}

// Sealed is declared only by a hidden method.
error Forbidden Sealed

@prefix("/hidden")
service HiddenNotes {
	@doc("Answers a Note; documented.")
	get Read /note {
		response Note
	}

	@hidden
	@security(InternalKey)
	@errors(Sealed)
	get Peek /peek {
		request  Stash
		response Vault<Secret>
	}
}

@hidden
extend service HiddenNotes {
	post Rotate /rotate {
		request  Secret
		response Note
	}
}

@hidden
@prefix("/hidden-ops")
service HiddenOps {
	get Ping /ping {
		response Note
	}
}
